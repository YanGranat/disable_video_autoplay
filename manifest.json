{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.3.45",
  "minimum_chrome_version": "119",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": ["*://*/*"],
      "match_origin_as_fallback": true,
      "js": ["dist/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "all_frames": true,
      "matches": ["*://*/*"],
      "match_origin_as_fallback": true,
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
